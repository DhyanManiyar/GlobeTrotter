@model GlobeTrotter.Models.BuildItineraryViewModel
@{
    ViewBag.Title = "Build Itinerary - " + Model.Title;
    string userAvatar = string.IsNullOrWhiteSpace(Model.OwnerAvatarUrl) ? "https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=120&q=80" : Model.OwnerAvatarUrl;
    decimal budgetPercent = Model.TotalBudget > 0 ? Math.Min(100, Math.Round((Model.TotalCalculatedCost / Model.TotalBudget) * 100)) : 0;
    string shareUrl = Request.Url != null ? $"{Request.Url.Scheme}://{Request.Url.Authority}{Url.Action("Share", "Trips", new { id = Model.TripId })}" : $"/Trips/Share/{Model.TripId}";
    int totalDays = Math.Max(1, (Model.EndDate - Model.StartDate).Days);
}

<div class="gt-auth-page" style="padding: 40px 20px 80px; display: block; max-width: 1040px; margin: 0 auto;">
    <div class="gt-hero-ambient-glow" style="top: 2%;"></div>

    <!-- Top App Navigation / Header Matching Wireframe -->
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px; padding: 14px 20px; background: #FFFFFF; border: 1px solid var(--gt-border); border-radius: var(--gt-radius-xl); box-shadow: var(--gt-shadow-xs);">
        <a href="@Url.Action("Index", "Trips")" style="display: flex; align-items: center; gap: 10px; text-decoration: none;">
            <div class="gt-brand-icon" style="width: 34px; height: 34px; font-size: 15px;">
                <i class="fa-solid fa-earth-americas"></i>
            </div>
            <span style="font-family: var(--gt-font-display); font-size: 18px; font-weight: 800; color: var(--gt-zinc-950); letter-spacing: -0.03em;">
                GlobeTrotter
            </span>
        </a>

        <div style="display: flex; align-items: center; gap: 10px;">
            <button type="button" class="gt-tag-btn" onclick="openShareModal()" style="padding: 6px 14px; font-size: 13px; font-weight: 600;" title="Share Itinerary">
                <i class="fa-solid fa-share-nodes" style="margin-right: 4px; color: var(--gt-brand-primary);"></i> Share Plan
            </button>
            <a href="@Url.Action("Index", "Trips")" class="gt-tag-btn" style="padding: 6px 14px; font-size: 13px;">
                <i class="fa-solid fa-arrow-left" style="margin-right: 4px;"></i> Dashboard
            </a>
            <a href="@Url.Action("Profile", "Manage")" style="width: 40px; height: 40px; border-radius: 50%; overflow: hidden; border: 2px solid var(--gt-brand-light); box-shadow: var(--gt-shadow-xs); display: block;" title="My Profile">
                <img src="@userAvatar" alt="User" style="width: 100%; height: 100%; object-fit: cover;" />
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="gt-val-summary" style="background: #ECFDF5; border-color: #A7F3D0; color: #065F46; margin-bottom: 20px; display:flex; align-items:center; justify-content:space-between;">
            <div>
                <i class="fa-solid fa-circle-check" style="color: #10B981; margin-right: 8px;"></i>
                <span>@TempData["SuccessMessage"]</span>
            </div>
            <button type="button" onclick="this.parentElement.remove()" style="background:none; border:none; color:#065F46; cursor:pointer;"><i class="fa-solid fa-xmark"></i></button>
        </div>
    }

    <!-- Trip Overview Banner -->
    <div style="background: #FFFFFF; border: 1px solid var(--gt-border); border-radius: var(--gt-radius-xl); padding: 22px 28px; box-shadow: var(--gt-shadow-xs); margin-bottom: 24px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px;">
        <div>
            <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
                <h1 style="font-size: 24px; font-weight: 800; color: var(--gt-zinc-950); letter-spacing: -0.02em;">
                    @Model.Title
                </h1>
                <span class="gt-tier-tag" style="background: rgba(99, 102, 241, 0.08); color: var(--gt-brand-primary); font-weight: 700;">
                    @Model.Sections.Count Sections • @totalDays Days
                </span>
            </div>
            <p style="font-size: 13.5px; color: var(--gt-zinc-500); margin-top: 4px;">
                <i class="fa-regular fa-calendar" style="margin-right: 4px;"></i>
                @Model.StartDate.ToString("MMM dd, yyyy") - @Model.EndDate.ToString("MMM dd, yyyy")
            </p>
        </div>

        <!-- Live Financial Gauge & Actions -->
        <div style="display: flex; align-items: center; gap: 16px;">
            <div style="text-align: right;">
                <span style="font-size: 11.5px; font-weight: 700; color: var(--gt-zinc-400); text-transform: uppercase;">Estimated Budget</span>
                <div style="font-size: 20px; font-weight: 800; color: @(Model.TotalCalculatedCost > Model.TotalBudget ? "#DC2626" : "var(--gt-zinc-950)");">
                    $@Model.TotalCalculatedCost.ToString("N0") <span style="font-size: 13px; font-weight: 500; color: var(--gt-zinc-400);">/ $@Model.TotalBudget.ToString("N0")</span>
                </div>
            </div>
            <a href="@Url.Action("Edit", "Trips", new { id = Model.TripId })" class="gt-tag-btn" style="padding: 8px 14px;" title="Edit Trip Metadata">
                <i class="fa-solid fa-gear"></i>
            </a>
        </div>
    </div>

    <!-- ======================================================================
         INTERACTIVE VIEW SWITCHER (SECTIONS / TIMELINE / CALENDAR / BUDGET)
         ====================================================================== -->
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px; flex-wrap: wrap; gap: 12px;">
        <div style="display: flex; gap: 6px; background: #FFFFFF; border: 1px solid var(--gt-border); padding: 4px 6px; border-radius: var(--gt-radius-full); box-shadow: var(--gt-shadow-xs);">
            <button type="button" class="gt-nav-link active" id="btnTabSections" onclick="switchItineraryView('sections')">
                <i class="fa-solid fa-list-check" style="margin-right: 5px;"></i> Sections (Screen 5)
            </button>
            <button type="button" class="gt-nav-link" id="btnTabTimeline" onclick="switchItineraryView('timeline')">
                <i class="fa-solid fa-route" style="margin-right: 5px;"></i> Visual Timeline
            </button>
            <button type="button" class="gt-nav-link" id="btnTabCalendar" onclick="switchItineraryView('calendar')">
                <i class="fa-regular fa-calendar-days" style="margin-right: 5px;"></i> Day Calendar
            </button>
            <button type="button" class="gt-nav-link" id="btnTabBudget" onclick="switchItineraryView('budget')">
                <i class="fa-solid fa-chart-pie" style="margin-right: 5px;"></i> Budget Breakdown
            </button>
        </div>

        <button type="button" class="gt-btn-add" onclick="toggleAddSectionForm()" style="padding: 8px 18px; font-size: 13px; font-weight: 700;">
            <i class="fa-solid fa-plus" style="margin-right: 6px;"></i> + Add another Section
        </button>
    </div>

    <!-- ======================================================================
         VIEW 1: BUILD ITINERARY SECTIONS (SCREEN 5 WIREFRAME LAYOUT)
         ====================================================================== -->
    <div id="viewSectionsContainer" style="display: flex; flex-direction: column; gap: 20px; margin-bottom: 28px;">
        @if (Model.Sections.Count == 0)
        {
            <div style="background: #FFFFFF; border: 1px dashed var(--gt-zinc-300); border-radius: var(--gt-radius-xl); padding: 48px 20px; text-align: center;">
                <p style="font-size: 15px; font-weight: 600; color: var(--gt-zinc-600); margin-bottom: 16px;">
                    No sections added yet. Click "+ Add another Section" below to add your first destination or activity block!
                </p>
            </div>
        }
        else
        {
            foreach (var sec in Model.Sections)
            {
                <div class="gt-itinerary-section-card" style="background: #FFFFFF; border: 1.5px solid var(--gt-border); border-radius: var(--gt-radius-xl); padding: 24px 26px; box-shadow: var(--gt-shadow-card); transition: all 0.2s ease;">
                    <!-- Section Header -->
                    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px;">
                        <h3 style="font-size: 18px; font-weight: 800; color: var(--gt-zinc-950); letter-spacing: -0.02em; display: flex; align-items: center; gap: 8px;">
                            <span style="color: var(--gt-brand-primary);">Section @sec.SectionNumber:</span>
                            <span>@sec.PlaceName, @sec.Country</span>
                        </h3>

                        <div style="display: flex; align-items: center; gap: 8px;">
                            <button type="button" class="gt-tag-btn" onclick="openAddActivityModal(@sec.TripStopId, '@sec.PlaceName')" style="padding: 5px 12px; font-size: 12.5px;" title="Add Activity to Section">
                                <i class="fa-solid fa-plus" style="margin-right: 4px;"></i> Activity
                            </button>
                            
                            @using (Html.BeginForm("DeleteSection", "Trips", new { stopId = sec.TripStopId, tripId = Model.TripId }, FormMethod.Post, new { onsubmit = "return confirm('Remove Section " + sec.SectionNumber + " from itinerary?');" }))
                            {
                                @Html.AntiForgeryToken()
                                <button type="submit" class="gt-tag-btn" style="color: #DC2626; border-color: rgba(220,38,38,0.2); padding: 5px 9px;" title="Delete Section">
                                    <i class="fa-regular fa-trash-can"></i>
                                </button>
                            }
                        </div>
                    </div>

                    <!-- Section Body / Information Area -->
                    <div style="background: var(--gt-zinc-50); border: 1px solid var(--gt-zinc-200); border-radius: var(--gt-radius-md); padding: 14px 16px; margin-bottom: 16px;">
                        <p style="font-size: 14px; color: var(--gt-zinc-700); line-height: 1.5; margin-bottom: 8px;">
                            @(string.IsNullOrWhiteSpace(sec.Notes) ? "All the necessary information about this section. This can be anything like travel section, hotel or any other activity." : sec.Notes)
                        </p>

                        <div style="display: flex; flex-wrap: wrap; gap: 14px; font-size: 12.5px; color: var(--gt-zinc-500); margin-top: 6px;">
                            <span><i class="fa-solid fa-hotel" style="color: var(--gt-brand-primary); margin-right: 4px;"></i> Stay: <strong>@sec.AccommodationDetails</strong> ($@sec.AccommodationCost.ToString("N0"))</span>
                            <span><i class="fa-solid fa-plane" style="color: #06B6D4; margin-right: 4px;"></i> Transport: <strong>@sec.TransportMode</strong> ($@sec.TransportCost.ToString("N0"))</span>
                        </div>

                        <!-- Activities within this section -->
                        @if (sec.Activities.Count > 0)
                        {
                            <div style="margin-top: 12px; border-top: 1px dashed var(--gt-zinc-200); padding-top: 10px;">
                                <div style="font-size: 11.5px; font-weight: 700; color: var(--gt-zinc-400); text-transform: uppercase; margin-bottom: 6px;">
                                    Planned Activities (@sec.Activities.Count):
                                </div>
                                <div style="display: flex; flex-wrap: wrap; gap: 8px;">
                                    @foreach (var act in sec.Activities)
                                    {
                                        <div style="background: #FFFFFF; border: 1px solid var(--gt-zinc-200); border-radius: var(--gt-radius-md); padding: 4px 10px; font-size: 12px; display: flex; align-items: center; gap: 6px; box-shadow: var(--gt-shadow-xs);">
                                            <i class="fa-solid fa-ticket" style="color: var(--gt-brand-primary); font-size: 11px;"></i>
                                            <span style="font-weight: 600; color: var(--gt-zinc-900);">@act.CustomTitle</span>
                                            <span style="color: var(--gt-brand-emerald); font-weight: 700;">$@act.Cost.ToString("N0")</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Section Footer Info Pills Matching Screen 5 Wireframe -->
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px;">
                        <!-- Date Range Pill -->
                        <div style="background: #FFFFFF; border: 1.5px solid var(--gt-zinc-200); border-radius: var(--gt-radius-md); padding: 10px 14px; display: flex; align-items: center; justify-content: space-between; font-size: 13.5px;">
                            <span style="font-weight: 600; color: var(--gt-zinc-500);">Date Range:</span>
                            <span style="font-weight: 700; color: var(--gt-zinc-950);">@sec.DateRangeDisplay</span>
                        </div>

                        <!-- Budget of this section Pill -->
                        <div style="background: #FFFFFF; border: 1.5px solid var(--gt-zinc-200); border-radius: var(--gt-radius-md); padding: 10px 14px; display: flex; align-items: center; justify-content: space-between; font-size: 13.5px;">
                            <span style="font-weight: 600; color: var(--gt-zinc-500);">Budget of this section:</span>
                            <span style="font-weight: 800; color: var(--gt-brand-primary);">$@sec.SectionBudget.ToString("N0")</span>
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    <!-- ======================================================================
         VIEW 2: VISUAL ROUTE & TIMELINE
         ====================================================================== -->
    <div id="viewTimelineContainer" style="display: none; flex-direction: column; gap: 24px; margin-bottom: 28px;">
        <div style="background: #FFFFFF; border: 1px solid var(--gt-border); border-radius: var(--gt-radius-xl); padding: 32px 36px; box-shadow: var(--gt-shadow-card);">
            <h3 style="font-size: 20px; font-weight: 800; color: var(--gt-zinc-950); margin-bottom: 24px; display: flex; align-items: center; gap: 8px;">
                <i class="fa-solid fa-map-location-dot" style="color: var(--gt-brand-primary);"></i>
                Sequential Journey Route & Timeline
            </h3>

            <div style="position: relative; padding-left: 20px;">
                <!-- Timeline spine -->
                <div style="position: absolute; left: 35px; top: 15px; bottom: 25px; width: 3px; background: linear-gradient(to bottom, #6366F1, #06B6D4);"></div>

                @foreach (var sec in Model.Sections)
                {
                    <div style="display: flex; gap: 24px; margin-bottom: 32px; position: relative;">
                        <!-- Timeline Node Icon -->
                        <div style="width: 32px; height: 32px; border-radius: 50%; background: var(--gt-brand-primary); color: white; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 13px; z-index: 2; box-shadow: 0 0 0 5px #FFFFFF, var(--gt-shadow-sm);">
                            @sec.SectionNumber
                        </div>

                        <!-- Card Content -->
                        <div style="flex: 1; background: var(--gt-zinc-50); border: 1px solid var(--gt-zinc-200); border-radius: var(--gt-radius-lg); padding: 20px; box-shadow: var(--gt-shadow-xs);">
                            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px; margin-bottom: 10px;">
                                <h4 style="font-size: 17px; font-weight: 800; color: var(--gt-zinc-950);">
                                    @sec.PlaceName, @sec.Country
                                </h4>
                                <span class="gt-tag-btn" style="padding: 4px 10px; font-size: 12px; font-weight: 700; color: var(--gt-brand-primary);">
                                    @sec.ArrivalDate.ToString("MMM dd") → @sec.DepartureDate.ToString("MMM dd, yyyy")
                                </span>
                            </div>

                            <p style="font-size: 13.5px; color: var(--gt-zinc-600); margin-bottom: 12px;">
                                @sec.Notes
                            </p>

                            <div style="display: flex; flex-wrap: wrap; gap: 10px; font-size: 12.5px;">
                                <span style="background: white; border: 1px solid var(--gt-zinc-200); padding: 4px 10px; border-radius: var(--gt-radius-md); font-weight: 600;">
                                    🏨 @sec.AccommodationDetails ($@sec.AccommodationCost.ToString("N0"))
                                </span>
                                <span style="background: white; border: 1px solid var(--gt-zinc-200); padding: 4px 10px; border-radius: var(--gt-radius-md); font-weight: 600;">
                                    🚆 @sec.TransportMode ($@sec.TransportCost.ToString("N0"))
                                </span>
                                <span style="background: white; border: 1px solid var(--gt-zinc-200); padding: 4px 10px; border-radius: var(--gt-radius-md); font-weight: 700; color: var(--gt-brand-emerald);">
                                    💰 Section Total: $@sec.SectionBudget.ToString("N0")
                                </span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- ======================================================================
         VIEW 3: DAY-BY-DAY CALENDAR & SCHEDULE
         ====================================================================== -->
    <div id="viewCalendarContainer" style="display: none; flex-direction: column; gap: 20px; margin-bottom: 28px;">
        <div style="background: #FFFFFF; border: 1px solid var(--gt-border); border-radius: var(--gt-radius-xl); padding: 32px 36px; box-shadow: var(--gt-shadow-card);">
            <h3 style="font-size: 20px; font-weight: 800; color: var(--gt-zinc-950); margin-bottom: 20px; display: flex; align-items: center; gap: 8px;">
                <i class="fa-regular fa-calendar-days" style="color: var(--gt-brand-primary);"></i>
                Day-by-Day Schedule & Itinerary Planner
            </h3>

            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px;">
                @for (int day = 0; day < totalDays; day++)
                {
                    var currentDate = Model.StartDate.AddDays(day);
                    var activeSection = Model.Sections.FirstOrDefault(s => currentDate >= s.ArrivalDate && currentDate <= s.DepartureDate) ?? Model.Sections.FirstOrDefault();
                    
                    <div style="background: var(--gt-zinc-50); border: 1px solid var(--gt-zinc-200); border-radius: var(--gt-radius-lg); padding: 16px; display: flex; flex-direction: column; justify-content: space-between;">
                        <div>
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                                <span style="font-size: 13px; font-weight: 800; color: var(--gt-brand-primary);">Day @(day + 1)</span>
                                <span style="font-size: 12px; font-weight: 600; color: var(--gt-zinc-500);">@currentDate.ToString("ddd, MMM dd")</span>
                            </div>

                            <div style="font-size: 14px; font-weight: 700; color: var(--gt-zinc-950); margin-bottom: 6px;">
                                📍 @(activeSection?.PlaceName ?? "Transit Stop")
                            </div>

                            <p style="font-size: 12px; color: var(--gt-zinc-500); line-height: 1.4; margin-bottom: 10px;">
                                @(activeSection != null ? $"Exploring highlights and sights of {activeSection.PlaceName}." : "Scheduled travel.")
                            </p>
                        </div>

                        <div style="border-top: 1px solid var(--gt-zinc-200); padding-top: 8px; font-size: 11.5px; color: var(--gt-zinc-600); display: flex; justify-content: space-between;">
                            <span>Stay: <strong>@(activeSection?.AccommodationDetails ?? "Standard")</strong></span>
                            <span style="color: var(--gt-brand-emerald); font-weight: 700;">$@((activeSection?.SectionBudget / Math.Max(1, totalDays)).ToString("N0"))/day</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- ======================================================================
         VIEW 4: BUDGET BREAKDOWN & FINANCIAL ANALYTICS
         ====================================================================== -->
    <div id="viewBudgetContainer" style="display: none; flex-direction: column; gap: 24px; margin-bottom: 28px;">
        <div style="background: #FFFFFF; border: 1px solid var(--gt-border); border-radius: var(--gt-radius-xl); padding: 32px 36px; box-shadow: var(--gt-shadow-card);">
            <h3 style="font-size: 20px; font-weight: 800; color: var(--gt-zinc-950); margin-bottom: 24px; display: flex; align-items: center; gap: 8px;">
                <i class="fa-solid fa-chart-pie" style="color: var(--gt-brand-primary);"></i>
                Automated Trip Budget & Expense Allocation
            </h3>

            @{
                decimal totalStay = Model.Sections.Sum(s => s.AccommodationCost);
                decimal totalTransport = Model.Sections.Sum(s => s.TransportCost);
                decimal totalActivities = Model.Sections.SelectMany(s => s.Activities).Sum(a => a.Cost);
                decimal remaining = Math.Max(0, Model.TotalBudget - Model.TotalCalculatedCost);
            }

            <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 28px;">
                <div style="background: var(--gt-zinc-50); border: 1px solid var(--gt-zinc-200); border-radius: var(--gt-radius-md); padding: 16px;">
                    <div style="font-size: 11.5px; font-weight: 700; color: var(--gt-zinc-400); text-transform: uppercase;">🏨 Accommodations</div>
                    <div style="font-size: 22px; font-weight: 800; color: var(--gt-brand-primary); margin-top: 2px;">$@totalStay.ToString("N0")</div>
                </div>
                <div style="background: var(--gt-zinc-50); border: 1px solid var(--gt-zinc-200); border-radius: var(--gt-radius-md); padding: 16px;">
                    <div style="font-size: 11.5px; font-weight: 700; color: var(--gt-zinc-400); text-transform: uppercase;">🚆 Transport</div>
                    <div style="font-size: 22px; font-weight: 800; color: #06B6D4; margin-top: 2px;">$@totalTransport.ToString("N0")</div>
                </div>
                <div style="background: var(--gt-zinc-50); border: 1px solid var(--gt-zinc-200); border-radius: var(--gt-radius-md); padding: 16px;">
                    <div style="font-size: 11.5px; font-weight: 700; color: var(--gt-zinc-400); text-transform: uppercase;">🎟️ Activities</div>
                    <div style="font-size: 22px; font-weight: 800; color: var(--gt-brand-emerald); margin-top: 2px;">$@totalActivities.ToString("N0")</div>
                </div>
                <div style="background: var(--gt-zinc-50); border: 1px solid var(--gt-zinc-200); border-radius: var(--gt-radius-md); padding: 16px;">
                    <div style="font-size: 11.5px; font-weight: 700; color: var(--gt-zinc-400); text-transform: uppercase;">💵 Buffer Left</div>
                    <div style="font-size: 22px; font-weight: 800; color: var(--gt-zinc-950); margin-top: 2px;">$@remaining.ToString("N0")</div>
                </div>
            </div>

            <!-- Progress Bar -->
            <div style="margin-top: 10px;">
                <div style="display: flex; justify-content: space-between; font-size: 13px; font-weight: 700; margin-bottom: 6px;">
                    <span>Budget Allocation Progress</span>
                    <span>@budgetPercent% of $@Model.TotalBudget.ToString("N0")</span>
                </div>
                <div style="height: 12px; background: var(--gt-zinc-100); border-radius: var(--gt-radius-full); overflow: hidden;">
                    <div style="height: 100%; width: @budgetPercent%; background: linear-gradient(90deg, #6366F1, #10B981); border-radius: var(--gt-radius-full);"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- ======================================================================
         "+ ADD ANOTHER SECTION" MODAL/COLLAPSIBLE FORM (SCREEN 5)
         ====================================================================== -->
    <div id="addSectionContainer" style="display: none; background: #FFFFFF; border: 1.5px solid var(--gt-brand-light); border-radius: var(--gt-radius-xl); padding: 26px 30px; box-shadow: var(--gt-shadow-modal); margin-bottom: 28px;">
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 18px; border-bottom: 1px solid var(--gt-border-subtle); padding-bottom: 12px;">
            <h3 style="font-size: 18px; font-weight: 800; color: var(--gt-zinc-950); display: flex; align-items: center; gap: 8px;">
                <i class="fa-solid fa-map-pin" style="color: var(--gt-brand-primary);"></i>
                Configure Next Section (Stop #@(Model.Sections.Count + 1))
            </h3>
            <button type="button" onclick="toggleAddSectionForm()" style="background: none; border: none; font-size: 20px; color: var(--gt-zinc-400); cursor: pointer;">&times;</button>
        </div>

        @using (Html.BeginForm("AddSection", "Trips", FormMethod.Post, new { id = "addSectionForm" }))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="TripId" value="@Model.TripId" />

            <div class="gt-form-grid" style="grid-template-columns: 1fr 1fr; gap: 14px 16px;">
                <!-- City Selection -->
                <div class="gt-form-group full-width" style="grid-column: 1 / -1;">
                    <label class="gt-form-label">Select Destination Place / City *</label>
                    <div class="gt-input-box">
                        <i class="fa-solid fa-location-dot input-icon"></i>
                        <select name="CityId" class="gt-auth-input" required="required">
                            <option value="">-- Choose Next City --</option>
                            @foreach (var city in Model.AvailableCities)
                            {
                                <option value="@city.CityId">
                                    @city.Name, @city.Country (Avg $@city.AvgDailyCost.ToString("N0")/day)
                                </option>
                            }
                        </select>
                    </div>
                </div>

                <!-- Arrival & Departure Dates -->
                <div class="gt-form-group">
                    <label class="gt-form-label">Section Arrival Date *</label>
                    <div class="gt-input-box">
                        <i class="fa-regular fa-calendar input-icon"></i>
                        <input type="date" name="ArrivalDate" class="gt-auth-input" value="@Model.EndDate.ToString("yyyy-MM-dd")" required="required" />
                    </div>
                </div>

                <div class="gt-form-group">
                    <label class="gt-form-label">Section Departure Date *</label>
                    <div class="gt-input-box">
                        <i class="fa-regular fa-calendar input-icon"></i>
                        <input type="date" name="DepartureDate" class="gt-auth-input" value="@Model.EndDate.AddDays(3).ToString("yyyy-MM-dd")" required="required" />
                    </div>
                </div>

                <!-- Hotel / Stay Budget & Transport -->
                <div class="gt-form-group">
                    <label class="gt-form-label">Accommodation Budget ($)</label>
                    <div class="gt-input-box">
                        <i class="fa-solid fa-hotel input-icon"></i>
                        <input type="number" step="10" name="AccommodationCost" class="gt-auth-input" placeholder="e.g. 350" />
                    </div>
                </div>

                <div class="gt-form-group">
                    <label class="gt-form-label">Transport Mode</label>
                    <div class="gt-input-box">
                        <i class="fa-solid fa-plane input-icon"></i>
                        <select name="TransportMode" class="gt-auth-input">
                            <option value="Flight">Flight</option>
                            <option value="High-Speed Train">High-Speed Train</option>
                            <option value="Rental Car / Drive">Rental Car / Drive</option>
                            <option value="Ferry / Boat">Ferry / Boat</option>
                        </select>
                    </div>
                </div>

                <!-- Notes / Information -->
                <div class="gt-form-group full-width" style="grid-column: 1 / -1;">
                    <label class="gt-form-label">Section Notes & Information</label>
                    <textarea name="Notes" class="gt-auth-textarea" rows="2" placeholder="All the necessary information about this section. This can be anything like travel section, hotel or any other activity..."></textarea>
                </div>
            </div>

            <div style="margin-top: 18px; display: flex; justify-content: flex-end; gap: 10px;">
                <button type="button" class="gt-tag-btn" onclick="toggleAddSectionForm()">Cancel</button>
                <button type="submit" class="gt-btn-auth-primary" style="width: auto; padding: 10px 24px;">
                    <i class="fa-solid fa-check"></i>
                    <span>Add Section to Itinerary</span>
                </button>
            </div>
        }
    </div>
</div>

<!-- ==========================================================================
     SHARE ITINERARY MODAL
     ========================================================================== -->
<div id="shareModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.6); backdrop-filter: blur(4px); z-index: 9999; align-items: center; justify-content: center; padding: 20px;">
    <div style="background: #FFFFFF; border-radius: var(--gt-radius-xl); max-width: 480px; width: 100%; padding: 28px; box-shadow: var(--gt-shadow-modal);">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; border-bottom: 1px solid var(--gt-border-subtle); padding-bottom: 12px;">
            <h3 style="font-size: 18px; font-weight: 800; color: var(--gt-zinc-950); display: flex; align-items: center; gap: 8px;">
                <i class="fa-solid fa-share-nodes" style="color: var(--gt-brand-primary);"></i>
                Share Your Trip Plan
            </h3>
            <button type="button" onclick="closeShareModal()" style="background: none; border: none; font-size: 18px; cursor: pointer; color: var(--gt-zinc-400);">&times;</button>
        </div>

        <p style="font-size: 13.5px; color: var(--gt-zinc-600); margin-bottom: 16px;">
            Anyone with this link can view your itinerary, route stops, and cloned activities.
        </p>

        <div class="gt-input-box" style="margin-bottom: 16px;">
            <input type="text" id="shareUrlInput" value="@shareUrl" class="gt-auth-input" readonly="readonly" style="background: var(--gt-zinc-50); font-size: 13px;" />
        </div>

        <div style="display: flex; justify-content: flex-end; gap: 10px;">
            <a href="@shareUrl" target="_blank" class="gt-tag-btn" style="padding: 8px 16px; text-decoration: none;">
                <i class="fa-solid fa-arrow-up-right-from-square" style="margin-right: 4px;"></i> Preview
            </a>
            <button type="button" class="gt-btn-auth-primary" onclick="copyShareUrl()" style="width: auto; padding: 8px 22px;">
                <i class="fa-regular fa-copy"></i>
                <span>Copy Link</span>
            </button>
        </div>
    </div>
</div>

<!-- ==========================================================================
     ADD ACTIVITY TO SECTION MODAL
     ========================================================================== -->
<div id="addActivityModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.6); backdrop-filter: blur(4px); z-index: 9999; align-items: center; justify-content: center; padding: 20px;">
    <div style="background: #FFFFFF; border-radius: var(--gt-radius-xl); max-width: 440px; width: 100%; padding: 28px; box-shadow: var(--gt-shadow-modal);">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; border-bottom: 1px solid var(--gt-border-subtle); padding-bottom: 12px;">
            <h3 style="font-size: 18px; font-weight: 800; color: var(--gt-zinc-950);" id="modalActivityStopTitle">
                Add Activity
            </h3>
            <button type="button" onclick="closeAddActivityModal()" style="background: none; border: none; font-size: 18px; cursor: pointer; color: var(--gt-zinc-400);">&times;</button>
        </div>

        @using (Html.BeginForm("AddActivityToSection", "Trips", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="tripId" value="@Model.TripId" />
            <input type="hidden" name="TripStopId" id="modalTripStopId" value="" />

            <div class="gt-form-group" style="margin-bottom: 12px;">
                <label class="gt-form-label">Activity Title *</label>
                <input type="text" name="Title" class="gt-auth-input" placeholder="e.g. Louvre Guided Tour" required="required" />
            </div>

            <div class="gt-form-group" style="margin-bottom: 12px;">
                <label class="gt-form-label">Category</label>
                <select name="CategoryName" class="gt-auth-input">
                    <option value="Sightseeing">Sightseeing</option>
                    <option value="Food & Dining">Food & Dining</option>
                    <option value="Culture & History">Culture & History</option>
                    <option value="Adventure & Nature">Adventure & Nature</option>
                    <option value="Entertainment">Entertainment</option>
                </select>
            </div>

            <div class="gt-form-group" style="margin-bottom: 12px;">
                <label class="gt-form-label">Estimated Cost ($)</label>
                <input type="number" name="Cost" class="gt-auth-input" value="45" />
            </div>

            <div class="gt-form-group" style="margin-bottom: 16px;">
                <label class="gt-form-label">Notes</label>
                <textarea name="Notes" class="gt-auth-textarea" rows="2" placeholder="Ticket confirmation, meet-up place, or timings..."></textarea>
            </div>

            <div style="display: flex; justify-content: flex-end; gap: 10px;">
                <button type="button" class="gt-tag-btn" onclick="closeAddActivityModal()">Cancel</button>
                <button type="submit" class="gt-btn-auth-primary" style="width: auto; padding: 8px 22px;">Add Activity</button>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        function switchItineraryView(view) {
            document.querySelectorAll('#btnTabSections, #btnTabTimeline, #btnTabCalendar, #btnTabBudget').forEach(b => b.classList.remove('active'));
            
            document.getElementById('viewSectionsContainer').style.display = 'none';
            document.getElementById('viewTimelineContainer').style.display = 'none';
            document.getElementById('viewCalendarContainer').style.display = 'none';
            document.getElementById('viewBudgetContainer').style.display = 'none';

            if (view === 'timeline') {
                document.getElementById('btnTabTimeline').classList.add('active');
                document.getElementById('viewTimelineContainer').style.display = 'flex';
            } else if (view === 'calendar') {
                document.getElementById('btnTabCalendar').classList.add('active');
                document.getElementById('viewCalendarContainer').style.display = 'flex';
            } else if (view === 'budget') {
                document.getElementById('btnTabBudget').classList.add('active');
                document.getElementById('viewBudgetContainer').style.display = 'flex';
            } else {
                document.getElementById('btnTabSections').classList.add('active');
                document.getElementById('viewSectionsContainer').style.display = 'flex';
            }
        }

        function toggleAddSectionForm() {
            const form = document.getElementById('addSectionContainer');
            form.style.display = (form.style.display === 'none' || form.style.display === '') ? 'block' : 'none';
            if (form.style.display === 'block') {
                form.scrollIntoView({ behavior: 'smooth' });
            }
        }

        function openAddActivityModal(stopId, placeName) {
            document.getElementById('modalTripStopId').value = stopId;
            document.getElementById('modalActivityStopTitle').innerText = 'Add Activity to ' + placeName;
            document.getElementById('addActivityModal').style.display = 'flex';
        }

        function closeAddActivityModal() {
            document.getElementById('addActivityModal').style.display = 'none';
        }

        function openShareModal() {
            document.getElementById('shareModal').style.display = 'flex';
        }

        function closeShareModal() {
            document.getElementById('shareModal').style.display = 'none';
        }

        function copyShareUrl() {
            const input = document.getElementById('shareUrlInput');
            input.select();
            input.setSelectionRange(0, 99999);
            navigator.clipboard.writeText(input.value);
            showToast('📋 Trip share link copied to clipboard!');
            closeShareModal();
        }
    </script>
}
