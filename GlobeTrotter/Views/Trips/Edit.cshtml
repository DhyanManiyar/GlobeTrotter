@model GlobeTrotter.Models.EditTripViewModel
@{
    ViewBag.Title = "Edit Trip: " + Model.Title;
}

<div class="gt-auth-page" style="padding-top: 100px;">
    <div class="gt-hero-ambient-glow" style="top: 5%;"></div>

    <div class="gt-auth-card register-card">
        <!-- Header -->
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px; border-bottom: 1px solid var(--gt-border); padding-bottom: 16px;">
            <div style="display: flex; align-items: center; gap: 12px;">
                <div style="width: 44px; height: 44px; border-radius: var(--gt-radius-md); background: var(--gt-zinc-950); color: white; display: flex; align-items: center; justify-content: center; font-size: 18px;">
                    <i class="fa-solid fa-pen-to-square"></i>
                </div>
                <div>
                    <h2 style="font-size: 22px; font-weight: 800; color: var(--gt-zinc-950); letter-spacing: -0.03em;">
                        Edit Trip Details
                    </h2>
                    <p style="font-size: 13px; color: var(--gt-zinc-500);">
                        Update trip parameters, travel duration, budget caps, or cover photography
                    </p>
                </div>
            </div>
            <a href="@Url.Action("Index", "Trips")" class="gt-tag-btn" style="padding: 8px 14px;">
                <i class="fa-solid fa-arrow-left" style="margin-right: 4px;"></i> Back to Dashboard
            </a>
        </div>

        @using (Html.BeginForm("Edit", "Trips", FormMethod.Post, new { role = "form" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.TripId)

            if (!ViewData.ModelState.IsValid)
            {
                <div class="gt-val-summary">
                    <i class="fa-solid fa-circle-exclamation"></i> Please review the highlighted fields below.
                    @Html.ValidationSummary(true, "")
                </div>
            }

            <div class="gt-form-grid">
                <!-- Row 1: Title (Full width) -->
                <div class="gt-form-group full-width">
                    <label class="gt-form-label" for="txtTripTitle">Trip Title *</label>
                    <div class="gt-input-box">
                        <i class="fa-solid fa-heading input-icon"></i>
                        @Html.TextBoxFor(m => m.Title, new { 
                            @class = "gt-auth-input", 
                            id = "txtTripTitle", 
                            required = "required"
                        })
                    </div>
                    @Html.ValidationMessageFor(m => m.Title, "", new { @class = "field-validation-error" })
                </div>

                <!-- Row 2: Dates -->
                <div class="gt-form-group">
                    <label class="gt-form-label" for="dtStartDate">Departure Start Date *</label>
                    <div class="gt-input-box">
                        <i class="fa-regular fa-calendar input-icon"></i>
                        @Html.TextBoxFor(m => m.StartDate, "{0:yyyy-MM-dd}", new { 
                            @class = "gt-auth-input", 
                            id = "dtStartDate", 
                            type = "date",
                            required = "required"
                        })
                    </div>
                    @Html.ValidationMessageFor(m => m.StartDate, "", new { @class = "field-validation-error" })
                </div>

                <div class="gt-form-group">
                    <label class="gt-form-label" for="dtEndDate">Return End Date *</label>
                    <div class="gt-input-box">
                        <i class="fa-regular fa-calendar-check input-icon"></i>
                        @Html.TextBoxFor(m => m.EndDate, "{0:yyyy-MM-dd}", new { 
                            @class = "gt-auth-input", 
                            id = "dtEndDate", 
                            type = "date",
                            required = "required"
                        })
                    </div>
                    @Html.ValidationMessageFor(m => m.EndDate, "", new { @class = "field-validation-error" })
                </div>

                <!-- Row 3: Budget & Currency -->
                <div class="gt-form-group">
                    <label class="gt-form-label" for="txtBudget">Target Total Budget ($) *</label>
                    <div class="gt-input-box">
                        <i class="fa-solid fa-dollar-sign input-icon"></i>
                        @Html.TextBoxFor(m => m.TotalBudget, new { 
                            @class = "gt-auth-input", 
                            id = "txtBudget", 
                            type = "number",
                            step = "50",
                            required = "required"
                        })
                    </div>
                    @Html.ValidationMessageFor(m => m.TotalBudget, "", new { @class = "field-validation-error" })
                </div>

                <div class="gt-form-group">
                    <label class="gt-form-label" for="selCurrency">Currency</label>
                    <div class="gt-input-box">
                        <i class="fa-solid fa-money-bill-wave input-icon"></i>
                        @Html.DropDownListFor(m => m.Currency, new SelectList(new[] { "USD", "EUR", "GBP", "JPY", "INR", "AUD", "CAD" }, Model.Currency), new { 
                            @class = "gt-auth-input", 
                            id = "selCurrency"
                        })
                    </div>
                </div>

                <!-- Row 4: Cover Photo URL (Full width) -->
                <div class="gt-form-group full-width">
                    <label class="gt-form-label" for="txtCoverImage">Cover Photo URL</label>
                    <div class="gt-input-box">
                        <i class="fa-regular fa-image input-icon"></i>
                        @Html.TextBoxFor(m => m.CoverImageUrl, new { 
                            @class = "gt-auth-input", 
                            id = "txtCoverImage"
                        })
                    </div>
                </div>

                <!-- Row 5: Description (Full width) -->
                <div class="gt-form-group full-width">
                    <label class="gt-form-label" for="txtDesc">Trip Notes & Goals</label>
                    @Html.TextAreaFor(m => m.Description, new { 
                        @class = "gt-auth-textarea", 
                        id = "txtDesc", 
                        rows = 3
                    })
                </div>

                <!-- Row 6: Visibility Checkbox (Full width) -->
                <div class="gt-form-group full-width">
                    <label class="gt-checkbox-label" style="background: var(--gt-zinc-50); border: 1px solid var(--gt-zinc-200); border-radius: var(--gt-radius-md); padding: 12px 14px;">
                        @Html.CheckBoxFor(m => m.IsPublic)
                        <div>
                            <span style="font-weight: 700; color: var(--gt-zinc-950);">Publish to GlobeTrotter Community</span>
                            <p style="font-size: 12px; color: var(--gt-zinc-500); margin-top: 2px;">
                                Allow other travelers to view and fork/copy this itinerary once completed.
                            </p>
                        </div>
                    </label>
                </div>
            </div>

            <!-- Submit Action -->
            <div style="display: flex; align-items: center; justify-content: flex-end; gap: 12px; margin-top: 24px; border-top: 1px solid var(--gt-border); padding-top: 20px;">
                <a href="@Url.Action("Index", "Trips")" class="gt-tag-btn" style="padding: 10px 20px; font-weight: 600;">Cancel</a>
                <button type="submit" class="gt-btn-add" style="padding: 12px 28px; font-size: 14.5px; font-weight: 700;">
                    <i class="fa-solid fa-floppy-disk" style="margin-right: 6px;"></i> Save Changes
                </button>
            </div>
        }
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
