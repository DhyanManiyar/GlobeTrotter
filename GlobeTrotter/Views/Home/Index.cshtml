<!-- ==========================================================================
     11. INTERACTIVE CLIENT-SIDE ENGINE
     ========================================================================== -->
@section scripts {
<script>
    // 1. Toast Engine
    let toastTimeout;
    function showToast(message) {
        const toast = document.getElementById('gtToast');
        const msgEl = document.getElementById('gtToastMessage');
        msgEl.innerText = message;
        toast.classList.add('show');
        
        clearTimeout(toastTimeout);
        toastTimeout = setTimeout(() => {
            toast.classList.remove('show');
        }, 3200);
    }

    // 2. Region Filter System
    function selectRegion(regionName, buttonEl) {
        document.querySelectorAll('.gt-region-btn').forEach(btn => btn.classList.remove('active'));
        buttonEl.classList.add('active');

        const cards = document.querySelectorAll('.gt-card');
        let count = 0;

        cards.forEach(card => {
            const cardRegion = card.getAttribute('data-region');
            if (regionName === 'All' || cardRegion === regionName) {
                card.style.display = 'flex';
                count++;
            } else {
                card.style.display = 'none';
            }
        });

        document.getElementById('resultsCounter').innerText = `${count} destinations`;
        showToast(`Filtered by ${regionName} (${count} found)`);
    }

    // 3. Live Search Input Filter
    function handleSearchInput(query) {
        const cleanQuery = query.toLowerCase().trim();
        const cards = document.querySelectorAll('.gt-card');
        let count = 0;

        cards.forEach(card => {
            const name = (card.getAttribute('data-name') || '').toLowerCase();
            const region = (card.getAttribute('data-region') || '').toLowerCase();
            if (name.includes(cleanQuery) || region.includes(cleanQuery)) {
                card.style.display = 'flex';
                count++;
            } else {
                card.style.display = 'none';
            }
        });

        document.getElementById('resultsCounter').innerText = `${count} destinations`;
    }

    function executeSearch() {
        const input = document.getElementById('mainSearchInput').value;
        if (input.trim().length > 0) {
            handleSearchInput(input);
            showToast(`Searched for "${input}"`);
        } else {
            showToast('Type a destination, tag, or activity to search.');
        }
    }

    function filterByTag(tag) {
        document.getElementById('mainSearchInput').value = tag;
        handleSearchInput(tag);
        showToast(`Filtered by #${tag}`);
    }

    // 4. Sort System
    function applySort(criteria) {
        const grid = document.getElementById('destinationsGrid');
        const cards = Array.from(grid.querySelectorAll('.gt-card'));

        cards.sort((a, b) => {
            if (criteria === 'popularity') {
                return parseFloat(b.getAttribute('data-popularity')) - parseFloat(a.getAttribute('data-popularity'));
            } else if (criteria === 'cost-low') {
                return parseFloat(a.getAttribute('data-cost')) - parseFloat(b.getAttribute('data-cost'));
            } else if (criteria === 'cost-high') {
                return parseFloat(b.getAttribute('data-cost')) - parseFloat(a.getAttribute('data-cost'));
            } else if (criteria === 'rating') {
                return parseFloat(b.getAttribute('data-rating')) - parseFloat(a.getAttribute('data-rating'));
            }
            return 0;
        });

        cards.forEach(card => grid.appendChild(card));
        showToast(`Sorted by ${criteria}`);
    }

    // 5. Actions
    function addToTrip(cityName, cityId) {
        // AJAX quick add to user's most recent trip or prompt
        $.ajax({
            url: '@Url.Action("GetMyTripsJson", "Trips")',
            type: 'GET',
            success: function(trips) {
                if (trips && trips.length > 0) {
                    const firstTrip = trips[0];
                    $.post('@Url.Action("QuickAddCityStop", "Trips")', { tripId: firstTrip.TripId, cityId: cityId }, function(res) {
                        if (res.success) {
                            showToast(res.message);
                        } else {
                            showToast('Added ' + cityName + ' to ' + firstTrip.Title);
                        }
                    });
                } else {
                    window.location.href = '@Url.Action("Create", "Trips")';
                }
            },
            error: function() {
                // If not logged in, redirect to login
                window.location.href = '@Url.Action("Login", "Account")';
            }
        });
    }

    function openCreateTripModal() {
        window.location.href = '@Url.Action("Create", "Trips")';
    }

    function handleNewsletter(e) {
        e.preventDefault();
        showToast('Subscribed to GlobeTrotter updates!');
        e.target.reset();
    }
</script>
}