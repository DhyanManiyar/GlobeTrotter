@{
    ViewBag.Title = "Plan & Experience Multi-City Travel";
}

<!-- ==========================================================================
     1. FLOATING CAPSULE NAVIGATION (21st.dev Style)
     ========================================================================== -->
<header class="gt-navbar" id="mainNavbar">
    <div class="gt-nav-capsule">
        <!-- Brand Logo -->
        <a href="@Url.Action("Index", "Home")" class="gt-brand" aria-label="GlobeTrotter Home">
            <div class="gt-brand-logo-wrap">
                <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="32" cy="32" r="14" fill="url(#brandGrad)" />
                    <ellipse cx="32" cy="32" rx="22" ry="10" transform="rotate(-30 32 32)" stroke="#38BDF8" stroke-width="3" stroke-dasharray="4 2" />
                    <circle cx="48" cy="22" r="3.5" fill="#38BDF8" />
                    <defs>
                        <linearGradient id="brandGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" stop-color="#6366F1" />
                            <stop offset="100%" stop-color="#06B6D4" />
                        </linearGradient>
                    </defs>
                </svg>
            </div>
            <span class="gt-brand-name">GlobeTrotter</span>
            <span class="gt-brand-badge">SaaS</span>
        </a>

        <!-- Nav Links -->
        <nav>
            <ul class="gt-nav-menu">
                <li><a href="@Url.Action("Index", "User")" class="gt-nav-link"><i class="fa-solid fa-gauge" style="margin-right: 5px; color: var(--gt-brand-primary);"></i>Dashboard</a></li>
                <li><a href="@Url.Action("Trip", "User")" class="gt-nav-link">My Trips</a></li>
                <li><a href="@Url.Action("Index", "Community")" class="gt-nav-link">Community</a></li>
                <li><a href="@Url.Action("Index", "Explore")" class="gt-nav-link">Explore &amp; Search</a></li>
                <li><a href="@Url.Action("Profile", "Manage")" class="gt-nav-link">Profile</a></li>
            </ul>
        </nav>

        <!-- Right Nav Actions -->
        <div class="gt-nav-actions">
            <!-- Notification Icon -->
            <button type="button" class="gt-icon-btn" aria-label="Notifications" onclick="showToast('2 new itinerary recommendations available')">
                <i class="fa-regular fa-bell"></i>
                <span class="gt-badge-dot"></span>
            </button>

            <!-- User Pill / Auth Actions -->
            @if (Request.IsAuthenticated)
            {
                using (Html.BeginForm("LogOff", "Account", FormMethod.Post, new { id = "logoutForm", style = "display:none;" }))
                {
                    @Html.AntiForgeryToken()
                }
                <div style="display: flex; align-items: center; gap: 8px;">
                    <a href="@Url.Action("Profile", "Manage")" class="gt-user-pill" style="text-decoration: none;" title="Go to Traveler Profile">
                        <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=120&q=80" alt="Avatar" class="gt-user-avatar" />
                        <span>Profile</span>
                    </a>
                    <button type="button" onclick="document.getElementById('logoutForm').submit()" class="gt-tag-btn" style="padding: 6px 9px;" title="Log Off">
                        <i class="fa-solid fa-arrow-right-from-bracket" style="color: var(--gt-zinc-500);"></i>
                    </button>
                </div>
            }
            else
            {
                <a href="@Url.Action("Login", "Account")" class="gt-tag-btn" style="padding: 6px 14px; font-weight: 600;">Log in</a>
                <a href="@Url.Action("Register", "Account")" class="gt-btn-add" style="padding: 6px 14px; font-weight: 600;">Sign up</a>
            }
        </div>
    </div>
</header>

<!-- ==========================================================================
     2. HERO / SEARCH SECTION WITH AMBIENT GLOW
     ========================================================================== -->
<section class="gt-hero-section">
    <div class="gt-hero-ambient-glow"></div>
    <div class="gt-hero-content">
        <!-- Live Status Badge -->
        <div class="gt-live-badge">
            <span class="gt-pulse-dot"></span>
            <span>Intelligent Travel Engine v2.4</span>
            <span style="color: var(--gt-zinc-300);">•</span>
            <span style="color: var(--gt-brand-primary); font-weight: 700;">Over 12,000+ routes planned</span>
        </div>

        <h1 class="gt-hero-title">
            Where will you go <span class="gt-title-gradient">next?</span>
        </h1>
        <p class="gt-hero-desc">
            The all-in-one multi-city itinerary builder. Optimize travel stops, track daily budgets in real-time, and fork community adventures.
        </p>

        <!-- Command Style Search Bar -->
        <div class="gt-search-container" role="search">
            <i class="fa-solid fa-magnifying-glass gt-search-icon"></i>
            <input type="text" 
                   id="mainSearchInput" 
                   class="gt-search-input" 
                   placeholder="Search cities, activities, or tags (e.g. Paris, Sushi, Budget)..." 
                   aria-label="Search destinations or activities"
                   onkeyup="handleSearchInput(this.value)" />
            <button type="button" class="gt-search-btn" onclick="executeSearch()">
                <span>Explore</span>
                <i class="fa-solid fa-arrow-right" style="font-size: 12px;"></i>
            </button>
        </div>

        <!-- Quick Filter Tags -->
        <div class="gt-quick-tags">
            <span class="gt-quick-tag-label">Trending:</span>
            <button type="button" class="gt-tag-btn" onclick="filterByTag('Europe')">Europe</button>
            <button type="button" class="gt-tag-btn" onclick="filterByTag('Japan')">Japan</button>
            <button type="button" class="gt-tag-btn" onclick="filterByTag('Budget')">Budget Friendly</button>
            <button type="button" class="gt-tag-btn" onclick="filterByTag('Luxury')">Luxury</button>
            <button type="button" class="gt-tag-btn" onclick="filterByTag('Bali')">Bali</button>
        </div>
    </div>
</section>

<!-- ==========================================================================
     3. REGIONAL SELECTION & FILTERS
     ========================================================================== -->
<section class="gt-section" id="explore-section">
    <div class="gt-container">
        <!-- Region Segmented Pills -->
        <div class="gt-region-bar" role="tablist" aria-label="Region filters">
            <button type="button" class="gt-region-btn active" onclick="selectRegion('All', this)">
                <i class="fa-solid fa-earth-americas" style="color: #60A5FA;"></i>
                <span>All Regions</span>
            </button>
            <button type="button" class="gt-region-btn" onclick="selectRegion('Europe', this)">
                <i class="fa-solid fa-earth-europe" style="color: #818CF8;"></i>
                <span>Europe</span>
            </button>
            <button type="button" class="gt-region-btn" onclick="selectRegion('Asia', this)">
                <i class="fa-solid fa-earth-asia" style="color: #F87171;"></i>
                <span>Asia</span>
            </button>
            <button type="button" class="gt-region-btn" onclick="selectRegion('Americas', this)">
                <i class="fa-solid fa-earth-americas" style="color: #34D399;"></i>
                <span>Americas</span>
            </button>
            <button type="button" class="gt-region-btn" onclick="selectRegion('Africa', this)">
                <i class="fa-solid fa-earth-africa" style="color: #FBBF24;"></i>
                <span>Africa</span>
            </button>
            <button type="button" class="gt-region-btn" onclick="selectRegion('Oceania', this)">
                <i class="fa-solid fa-earth-oceania" style="color: #A78BFA;"></i>
                <span>Oceania</span>
            </button>
        </div>

        <!-- Filter & Sort Toolbar -->
        <div class="gt-control-bar">
            <div class="gt-control-group">
                <span style="font-size: 13px; font-weight: 600; color: var(--gt-zinc-500);">Group:</span>
                <select class="gt-select-custom" id="groupBySelect" onchange="applyFilters()">
                    <option value="all">All Destinations</option>
                    <option value="cost">By Cost Index</option>
                    <option value="region">By Region</option>
                </select>
                <button type="button" class="gt-tag-btn" style="padding: 6px 12px;" onclick="showToast('Active filters: Budget + Top Rated')">
                    <i class="fa-solid fa-sliders" style="margin-right: 4px;"></i> Filters
                </button>
            </div>

            <div class="gt-control-group">
                <span style="font-size: 13px; font-weight: 600; color: var(--gt-zinc-500);">Sort:</span>
                <select class="gt-select-custom" id="sortBySelect" onchange="applySort(this.value)">
                    <option value="popularity">Popularity</option>
                    <option value="cost-low">Cost: Low to High</option>
                    <option value="cost-high">Cost: High to Low</option>
                    <option value="rating">Rating: Highest</option>
                </select>
                <span style="font-size: 13px; font-weight: 700; color: var(--gt-brand-primary);" id="resultsCounter">
                    6 destinations
                </span>
            </div>
        </div>

        <!-- ==================================================================
             4. BENTO DESTINATION GRID (3x2)
             ================================================================== -->
        <div class="gt-dest-grid" id="destinationsGrid">
            <!-- Card 1: Paris -->
            <article class="gt-card" data-region="Europe" data-cost="220" data-rating="4.95" data-popularity="98" data-name="Paris France">
                <div class="gt-card-media">
                    <img src="https://images.unsplash.com/photo-1502602898657-3e91760cbb34?auto=format&fit=crop&w=800&q=80" alt="Paris" class="gt-card-img" loading="lazy" />
                    <div class="gt-card-overlay"></div>
                    <span class="gt-card-badge gt-badge-trending"><i class="fa-solid fa-fire"></i> Trending</span>
                    <div class="gt-card-header-info">
                        <h3 class="gt-city-name">Paris</h3>
                        <p class="gt-country-name"><i class="fa-solid fa-location-dot"></i> France, Europe</p>
                    </div>
                </div>
                <div class="gt-card-body">
                    <div class="gt-meta-row">
                        <div class="gt-rating-box">
                            <i class="fa-solid fa-star"></i>
                            <span>4.95</span>
                            <span class="gt-reviews">(2.3k)</span>
                        </div>
                        <span class="gt-tier-tag">Luxury</span>
                    </div>
                    <div class="gt-action-row">
                        <div class="gt-cost-tag">
                            <span class="gt-cost-label">Est. Daily</span>
                            <span class="gt-cost-val">$220/day</span>
                        </div>
                        <button type="button" class="gt-btn-add" onclick="addToTrip('Paris', 1)">
                            <i class="fa-solid fa-plus"></i> Add Stop
                        </button>
                    </div>
                </div>
            </article>

            <!-- Card 2: Tokyo -->
            <article class="gt-card" data-region="Asia" data-cost="160" data-rating="4.98" data-popularity="99" data-name="Tokyo Japan">
                <div class="gt-card-media">
                    <img src="https://images.unsplash.com/photo-1540959733332-eab4deabeeaf?auto=format&fit=crop&w=800&q=80" alt="Tokyo" class="gt-card-img" loading="lazy" />
                    <div class="gt-card-overlay"></div>
                    <span class="gt-card-badge gt-badge-top"><i class="fa-solid fa-star"></i> Top Rated</span>
                    <div class="gt-card-header-info">
                        <h3 class="gt-city-name">Tokyo</h3>
                        <p class="gt-country-name"><i class="fa-solid fa-location-dot"></i> Japan, Asia</p>
                    </div>
                </div>
                <div class="gt-card-body">
                    <div class="gt-meta-row">
                        <div class="gt-rating-box">
                            <i class="fa-solid fa-star"></i>
                            <span>4.98</span>
                            <span class="gt-reviews">(3.1k)</span>
                        </div>
                        <span class="gt-tier-tag">Moderate</span>
                    </div>
                    <div class="gt-action-row">
                        <div class="gt-cost-tag">
                            <span class="gt-cost-label">Est. Daily</span>
                            <span class="gt-cost-val">$160/day</span>
                        </div>
                        <button type="button" class="gt-btn-add" onclick="addToTrip('Tokyo', 2)">
                            <i class="fa-solid fa-plus"></i> Add Stop
                        </button>
                    </div>
                </div>
            </article>

            <!-- Card 3: Rome -->
            <article class="gt-card" data-region="Europe" data-cost="150" data-rating="4.90" data-popularity="95" data-name="Rome Italy">
                <div class="gt-card-media">
                    <img src="https://images.unsplash.com/photo-1552832230-c0197dd311b5?auto=format&fit=crop&w=800&q=80" alt="Rome" class="gt-card-img" loading="lazy" />
                    <div class="gt-card-overlay"></div>
                    <span class="gt-card-badge gt-badge-trending"><i class="fa-solid fa-fire"></i> Popular</span>
                    <div class="gt-card-header-info">
                        <h3 class="gt-city-name">Rome</h3>
                        <p class="gt-country-name"><i class="fa-solid fa-location-dot"></i> Italy, Europe</p>
                    </div>
                </div>
                <div class="gt-card-body">
                    <div class="gt-meta-row">
                        <div class="gt-rating-box">
                            <i class="fa-solid fa-star"></i>
                            <span>4.90</span>
                            <span class="gt-reviews">(1.9k)</span>
                        </div>
                        <span class="gt-tier-tag">Moderate</span>
                    </div>
                    <div class="gt-action-row">
                        <div class="gt-cost-tag">
                            <span class="gt-cost-label">Est. Daily</span>
                            <span class="gt-cost-val">$150/day</span>
                        </div>
                        <button type="button" class="gt-btn-add" onclick="addToTrip('Rome', 3)">
                            <i class="fa-solid fa-plus"></i> Add Stop
                        </button>
                    </div>
                </div>
            </article>

            <!-- Card 4: New York City -->
            <article class="gt-card" data-region="Americas" data-cost="280" data-rating="4.92" data-popularity="96" data-name="New York City United States">
                <div class="gt-card-media">
                    <img src="https://images.unsplash.com/photo-1496442226666-8d4d0e62e6e9?auto=format&fit=crop&w=800&q=80" alt="New York" class="gt-card-img" loading="lazy" />
                    <div class="gt-card-overlay"></div>
                    <span class="gt-card-badge gt-badge-featured"><i class="fa-solid fa-wand-magic-sparkles"></i> Featured</span>
                    <div class="gt-card-header-info">
                        <h3 class="gt-city-name">New York City</h3>
                        <p class="gt-country-name"><i class="fa-solid fa-location-dot"></i> USA, Americas</p>
                    </div>
                </div>
                <div class="gt-card-body">
                    <div class="gt-meta-row">
                        <div class="gt-rating-box">
                            <i class="fa-solid fa-star"></i>
                            <span>4.92</span>
                            <span class="gt-reviews">(2.8k)</span>
                        </div>
                        <span class="gt-tier-tag">Luxury</span>
                    </div>
                    <div class="gt-action-row">
                        <div class="gt-cost-tag">
                            <span class="gt-cost-label">Est. Daily</span>
                            <span class="gt-cost-val">$280/day</span>
                        </div>
                        <button type="button" class="gt-btn-add" onclick="addToTrip('New York City', 4)">
                            <i class="fa-solid fa-plus"></i> Add Stop
                        </button>
                    </div>
                </div>
            </article>

            <!-- Card 5: Bali -->
            <article class="gt-card" data-region="Asia" data-cost="65" data-rating="4.88" data-popularity="97" data-name="Bali Indonesia">
                <div class="gt-card-media">
                    <img src="https://images.unsplash.com/photo-1537996194471-e657df975ab4?auto=format&fit=crop&w=800&q=80" alt="Bali" class="gt-card-img" loading="lazy" />
                    <div class="gt-card-overlay"></div>
                    <span class="gt-card-badge gt-badge-top" style="background: rgba(6, 182, 212, 0.85);"><i class="fa-solid fa-tag"></i> Top Value</span>
                    <div class="gt-card-header-info">
                        <h3 class="gt-city-name">Bali</h3>
                        <p class="gt-country-name"><i class="fa-solid fa-location-dot"></i> Indonesia, Asia</p>
                    </div>
                </div>
                <div class="gt-card-body">
                    <div class="gt-meta-row">
                        <div class="gt-rating-box">
                            <i class="fa-solid fa-star"></i>
                            <span>4.88</span>
                            <span class="gt-reviews">(1.7k)</span>
                        </div>
                        <span class="gt-tier-tag" style="color: var(--gt-brand-emerald); font-weight: 800;">Budget</span>
                    </div>
                    <div class="gt-action-row">
                        <div class="gt-cost-tag">
                            <span class="gt-cost-label">Est. Daily</span>
                            <span class="gt-cost-val">$65/day</span>
                        </div>
                        <button type="button" class="gt-btn-add" onclick="addToTrip('Bali', 5)">
                            <i class="fa-solid fa-plus"></i> Add Stop
                        </button>
                    </div>
                </div>
            </article>

            <!-- Card 6: Barcelona -->
            <article class="gt-card" data-region="Europe" data-cost="145" data-rating="4.89" data-popularity="94" data-name="Barcelona Spain">
                <div class="gt-card-media">
                    <img src="https://images.unsplash.com/photo-1583422409516-2895a77efded?auto=format&fit=crop&w=800&q=80" alt="Barcelona" class="gt-card-img" loading="lazy" />
                    <div class="gt-card-overlay"></div>
                    <span class="gt-card-badge gt-badge-trending"><i class="fa-solid fa-fire"></i> Trending</span>
                    <div class="gt-card-header-info">
                        <h3 class="gt-city-name">Barcelona</h3>
                        <p class="gt-country-name"><i class="fa-solid fa-location-dot"></i> Spain, Europe</p>
                    </div>
                </div>
                <div class="gt-card-body">
                    <div class="gt-meta-row">
                        <div class="gt-rating-box">
                            <i class="fa-solid fa-star"></i>
                            <span>4.89</span>
                            <span class="gt-reviews">(2.1k)</span>
                        </div>
                        <span class="gt-tier-tag">Moderate</span>
                    </div>
                    <div class="gt-action-row">
                        <div class="gt-cost-tag">
                            <span class="gt-cost-label">Est. Daily</span>
                            <span class="gt-cost-val">$145/day</span>
                        </div>
                        <button type="button" class="gt-btn-add" onclick="addToTrip('Barcelona', 8)">
                            <i class="fa-solid fa-plus"></i> Add Stop
                        </button>
                    </div>
                </div>
            </article>
        </div>
    </div>
</section>

<!-- ==========================================================================
     5. RECENT ADVENTURES (MINIMALIST DASHBOARD)
     ========================================================================== -->
<section class="gt-adventures-section" id="my-trips-section">
    <div class="gt-container">
        <div class="gt-section-header">
            <div>
                <h2 class="gt-section-title">Your Recent Itineraries</h2>
                <p class="gt-section-desc">Manage stops, budget caps, and daily activity timelines</p>
            </div>
            <button type="button" class="gt-btn-add" style="padding: 8px 18px;" onclick="openCreateTripModal()">
                <i class="fa-solid fa-plus"></i> New Itinerary
            </button>
        </div>

        <div class="gt-trips-grid">
            <!-- Trip 1 -->
            <a href="javascript:void(0)" class="gt-trip-card" onclick="showToast('Loading 7-Day European Romance Itinerary...')">
                <div class="gt-trip-thumb">
                    <img src="https://images.unsplash.com/photo-1502602898657-3e91760cbb34?auto=format&fit=crop&w=400&q=80" alt="Paris" />
                    <span class="gt-trip-badge">Upcoming</span>
                </div>
                <div class="gt-trip-info">
                    <div>
                        <h3 class="gt-trip-title">7-Day European Romance</h3>
                        <p class="gt-trip-dates"><i class="fa-regular fa-calendar"></i> Sep 10 - 17, 2026</p>
                        <p class="gt-trip-cities"><i class="fa-solid fa-route"></i> 2 Cities (Paris, Rome)</p>
                    </div>
                    <div>
                        <div style="display: flex; justify-content: space-between; font-size: 11px; font-weight: 700; color: var(--gt-zinc-500); margin-bottom: 2px;">
                            <span>Itinerary</span>
                            <span>75%</span>
                        </div>
                        <div class="gt-progress-track">
                            <div class="gt-progress-fill" style="width: 75%;"></div>
                        </div>
                    </div>
                </div>
            </a>

            <!-- Trip 2 -->
            <a href="javascript:void(0)" class="gt-trip-card" onclick="showToast('Loading 10-Day Japan Odyssey...')">
                <div class="gt-trip-thumb">
                    <img src="https://images.unsplash.com/photo-1540959733332-eab4deabeeaf?auto=format&fit=crop&w=400&q=80" alt="Tokyo" />
                    <span class="gt-trip-badge" style="background: var(--gt-brand-primary);">Planning</span>
                </div>
                <div class="gt-trip-info">
                    <div>
                        <h3 class="gt-trip-title">10-Day Japan Odyssey</h3>
                        <p class="gt-trip-dates"><i class="fa-regular fa-calendar"></i> Oct 05 - 15, 2026</p>
                        <p class="gt-trip-cities"><i class="fa-solid fa-route"></i> 2 Cities (Tokyo, Kyoto)</p>
                    </div>
                    <div>
                        <div style="display: flex; justify-content: space-between; font-size: 11px; font-weight: 700; color: var(--gt-zinc-500); margin-bottom: 2px;">
                            <span>Itinerary</span>
                            <span>45%</span>
                        </div>
                        <div class="gt-progress-track">
                            <div class="gt-progress-fill" style="width: 45%;"></div>
                        </div>
                    </div>
                </div>
            </a>

            <!-- Trip 3 -->
            <a href="javascript:void(0)" class="gt-trip-card" onclick="showToast('Loading Bali Wellness Retreat...')">
                <div class="gt-trip-thumb">
                    <img src="https://images.unsplash.com/photo-1537996194471-e657df975ab4?auto=format&fit=crop&w=400&q=80" alt="Bali" />
                    <span class="gt-trip-badge" style="background: var(--gt-brand-emerald);">Draft</span>
                </div>
                <div class="gt-trip-info">
                    <div>
                        <h3 class="gt-trip-title">Bali Wellness & Hike</h3>
                        <p class="gt-trip-dates"><i class="fa-regular fa-calendar"></i> Nov 12 - 18, 2026</p>
                        <p class="gt-trip-cities"><i class="fa-solid fa-route"></i> 1 City (Ubud)</p>
                    </div>
                    <div>
                        <div style="display: flex; justify-content: space-between; font-size: 11px; font-weight: 700; color: var(--gt-zinc-500); margin-bottom: 2px;">
                            <span>Itinerary</span>
                            <span>20%</span>
                        </div>
                        <div class="gt-progress-track">
                            <div class="gt-progress-fill" style="width: 20%;"></div>
                        </div>
                    </div>
                </div>
            </a>
        </div>
    </div>
</section>

<!-- ==========================================================================
     6. CURATED ACTIVITIES CAROUSEL
     ========================================================================== -->
<section class="gt-section" id="activities-section">
    <div class="gt-container">
        <div class="gt-section-header">
            <div>
                <h2 class="gt-section-title">Curated Experiences</h2>
                <p class="gt-section-desc">Handpicked activities across world capitals with guaranteed pricing</p>
            </div>
        </div>

        <div class="gt-act-scroll">
            <!-- Activity 1 -->
            <div class="gt-act-card">
                <div class="gt-act-media">
                    <img src="https://images.unsplash.com/photo-1511739001486-6bfe10ce785f?auto=format&fit=crop&w=500&q=80" alt="Eiffel Tower" loading="lazy" />
                    <span class="gt-act-cat-tag">Sightseeing</span>
                </div>
                <div class="gt-act-content">
                    <h4 class="gt-act-heading">Eiffel Tower Summit & Champagne</h4>
                    <p style="font-size: 11.5px; color: var(--gt-zinc-400);">Paris, France</p>
                    <div class="gt-act-btm">
                        <span class="gt-act-price">$45.00</span>
                        <span class="gt-act-time"><i class="fa-regular fa-clock"></i> 2.5h</span>
                    </div>
                </div>
